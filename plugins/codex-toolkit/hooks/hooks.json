{
  "description": "回合结束时通过 Hook 提示显示脚本统计，不调用模型，不写入文件或数据库。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_metrics_hook.sh\"",
            "commandWindows": "py -3 -B \"${PLUGIN_ROOT}\\scripts\\metrics.py\" hook",
            "timeout": 30,
            "statusMessage": "显示本轮会话统计"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run_metrics_hook.sh\"",
            "commandWindows": "py -3 -B \"${PLUGIN_ROOT}\\scripts\\metrics.py\" hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
