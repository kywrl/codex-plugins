{
  "description": "本地会话统计；回合结束时把摘要直接显示在 Codex 输出末尾，不写入文件或数据库。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/metrics.py\" hook",
            "timeout": 30,
            "statusMessage": "显示本轮会话统计"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${PLUGIN_ROOT}/scripts/metrics.py\" hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
